# Server Port (Render automatically supplies PORT in production)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/bazora?retryWrites=true&w=majority

# JWT Authentication Secret Key
# Generate a strong, random 32+ character string
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# Add your deployed Vercel domain and local development URL
CLIENT_URL=https://your-bazora-frontend.vercel.app,http://localhost:5173

# ==========================================
# Optional: AI Provider Configuration
# Supported providers: Groq, Gemini, OpenAI
# ==========================================
# AI_API_KEY=your_ai_api_key_here
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1
